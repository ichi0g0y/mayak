{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/browser/*.js", "src/browser/shell-env.d.ts", "src/vite-env.d.ts"],
  "exclude": ["src/browser/*.test.js"]
}
