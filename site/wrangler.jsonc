// Cloudflare Worker "mayak": the landing page as static assets (site/dist,
// built by `bun run build`). `task site:deploy` builds and publishes it;
// sign in once with `wrangler login` (or set CLOUDFLARE_API_TOKEN).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mayak",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
